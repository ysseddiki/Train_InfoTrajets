[Unit]
Description=SNCF-Alerts Web UI (Vite + proxy /v1)
After=network.target sncf-alerts-api.service
Wants=sncf-alerts-api.service

[Service]
Type=simple
User=debian
WorkingDirectory=/home/debian/Train_InfoTrajets
EnvironmentFile=-/home/debian/Train_InfoTrajets/.env
# HTTPS direct (WEB_PORT=443) : capa bind privileged ports
# Derrière nginx (WEB_BEHIND_PROXY=true, port 5173) : capa inutile mais inoffensive
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Lecture des clés Let's Encrypt (groupe ssl-cert) si WEB_TLS_KEY
SupplementaryGroups=ssl-cert
ExecStart=/usr/bin/npm run dev:web
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
