# Copy to .env and fill values. NEVER commit .env

# --- API ---
# Écoute locale : nginx porte TLS, HSTS, CSP et limit_req. Exposer l'API directement
# (0.0.0.0) contourne ces protections — à ne faire qu'avec un pare-feu fermé.
API_HOST=127.0.0.1
API_PORT=3001
SESSION_SECRET=replace-with-long-random-string
SESSION_TTL_HOURS=12
# true if the web UI is served over HTTPS (port 443 / nginx LE)
COOKIE_SECURE=true

# NODE_ENV=production est positionné par les unités systemd (deploy/systemd/).
# Sans lui, le refus de démarrer sur ADMIN_PASSWORD=changeme est inactif.

# Proxies de confiance pour lire X-Forwarded-For (rate-limit par IP réelle).
# Vide = "loopback" (nginx local). Accepte IP, CIDR, ou false pour ne rien croire.
TRUSTED_PROXIES=

# Chiffrement des secrets en base (SMTP password, Navitia token)
# Générer une clé forte : openssl rand -base64 32
# Si non définie, les secrets sont stockés en clair (déconseillé en production)
SECRETS_ENCRYPTION_KEY=

# CORS: comma-separated allowed origins (empty = deny all browser origins)
# Example: https://trains.yseddiki.fr,https://backup.example.com
CORS_ORIGINS=

# --- Web (dev uniquement) ---
# En production, le client est un build statique servi par nginx :
#   npm run build -w @sncf-alerts/web  →  apps/web/dist
#   sudo ./scripts/setup-letsencrypt.sh domaine email
# Les variables ci-dessous ne concernent QUE le serveur de dev Vite.
#
# Dev local : laisser vide → HTTPS auto-signé Vite (basicSsl) sur :443
# WEB_HOST=127.0.0.1
# WEB_PORT=5173
# WEB_ALLOWED_HOSTS=localhost,127.0.0.1

# Premier compte admin (hashé en Postgres au premier boot).
# Ensuite : Admin → Comptes pour créer d’autres users ; mot de passe perso dans Compte.
# ADMIN_PASSWORD_SYNC=true écrase le hash du username bootstrap depuis ADMIN_PASSWORD.
# ⚠️  En production (NODE_ENV=production), ADMIN_PASSWORD doit être différent de "changeme".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Set true once to re-hash ADMIN_PASSWORD into DB, then set back to false
ADMIN_PASSWORD_SYNC=false

# Login rate limit — par IP réelle et par identifiant (backoff progressif)
LOGIN_RATE_MAX=10
LOGIN_RATE_MAX_USER=20
LOGIN_RATE_WINDOW_MS=900000

# Plafond de lecture par IP sur /v1/* (large : ne doit pas gêner l'UI)
READ_RATE_MAX=300
READ_RATE_WINDOW_MS=60000

# Budget d'appels sortants Open-Meteo (/v1/dashboard/day est accessible en visiteur)
WEATHER_BUDGET_MAX=120
WEATHER_BUDGET_WINDOW_MS=60000

# PostgreSQL
DATABASE_URL=postgres://sncf:sncf@127.0.0.1:5432/sncf_alerts

# Ingest (optionnel — bootstrap provider uniquement)
# La source de vérité tokens = Admin → Ingest (DB). Pas de NAVITIA_TOKEN ici.
INGEST_PROVIDER=stub
# false = l’API ne poll pas (utiliser sncf-alerts-ingest.service)
INGEST_IN_PROCESS=true
INGEST_INTERVAL_MS=300000
# TTL cache départs Navitia (ms)
DEPARTURES_CACHE_TTL_MS=90000
NAVITIA_DAILY_QUOTA=5000
# ↑ Jauge d’affichage Admin uniquement — n’arrête PAS le poll.
# L’ingest s’arrête seulement si l’API Navitia renvoie une erreur de quota (ex. 429).

# Email SMTP — bootstrap optionnel (source de vérité = Admin → Canaux)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Microsoft Teams Incoming Webhook
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=
