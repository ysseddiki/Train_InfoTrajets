# Copy to .env and fill values. NEVER commit .env

# --- API ---
API_HOST=0.0.0.0
API_PORT=3001
SESSION_SECRET=replace-with-long-random-string
SESSION_TTL_HOURS=12
# true if the web UI is served over HTTPS (port 443)
COOKIE_SECURE=true

# Premier compte admin (hashé en Postgres au premier boot).
# Ensuite : Admin → Comptes pour créer d’autres users ; mot de passe perso dans Compte.
# ADMIN_PASSWORD_SYNC=true écrase le hash du username bootstrap depuis ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Set true once to re-hash ADMIN_PASSWORD into DB, then set back to false
ADMIN_PASSWORD_SYNC=false

# Login rate limit
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MS=900000

# PostgreSQL
DATABASE_URL=postgres://sncf:sncf@127.0.0.1:5432/sncf_alerts

# Ingest (optionnel — bootstrap provider uniquement)
# La source de vérité tokens = Admin → Ingest (DB). Pas de NAVITIA_TOKEN ici.
INGEST_PROVIDER=stub
# false = l’API ne poll pas (utiliser sncf-alerts-ingest.service)
INGEST_IN_PROCESS=true
INGEST_INTERVAL_MS=300000
# TTL cache départs Navitia (ms)
DEPARTURES_CACHE_TTL_MS=90000
NAVITIA_DAILY_QUOTA=5000

# Email SMTP — bootstrap optionnel (source de vérité = Admin → Canaux)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Microsoft Teams Incoming Webhook
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=
