# Copy to .env and fill values. NEVER commit .env

# --- API ---
API_HOST=0.0.0.0
API_PORT=3001
SESSION_SECRET=replace-with-long-random-string
SESSION_TTL_HOURS=12
# true if the web UI is served over HTTPS (port 443)
COOKIE_SECURE=true

# Admin login (v1: single admin) — hashed in Postgres on first boot
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Set true once to re-hash ADMIN_PASSWORD into DB, then set back to false
ADMIN_PASSWORD_SYNC=false

# Login rate limit
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MS=900000

# PostgreSQL
DATABASE_URL=postgres://sncf:sncf@127.0.0.1:5432/sncf_alerts

# Ingest (optionnel — bootstrap initial uniquement)
# La source de vérité est Admin → Ingest (GET/PUT /v1/admin/ingest).
# Ces variables ne sont copiées en DB qu’au premier démarrage si rien n’est encore configuré.
INGEST_PROVIDER=stub
NAVITIA_TOKEN=
PRIM_API_KEY=
# Poll interval (reste en env)
INGEST_INTERVAL_MS=300000
# Quota journalier d’appels API SNCF/Navitia (reset minuit Europe/Paris)
NAVITIA_DAILY_QUOTA=5000

# Email SMTP custom
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Microsoft Teams Incoming Webhook
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=
